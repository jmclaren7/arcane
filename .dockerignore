# Version control
.git
.github
.gitignore

# Build artifacts
**/node_modules
# Listed per JS workspace on purpose. A recursive **/build also matched the Go
# source package backend/internal/build and stripped it from the build context,
# so the in-image go build failed with "no required module provides package
# .../internal/build". Docker patterns are relative to the context root and are
# not recursive without **, so these cover the workspaces that emit a build/
# directory without shadowing Go source anywhere.
build
frontend/build
tests/build
email-templates/build
.svelte-kit
**/.svelte-kit
coverage
.coverage
.nyc_output
.env
.env.*
!.env.example

# Development tools
.vscode
.idea
*.sublime-*
*.swp
*.swo

# Docker related
Dockerfile
.dockerignore
docker-compose*.yml

# Documentation and non-essential files
README.md
LICENSE
*.md
docs
tests
**/*.test.js
**/*.spec.js
**/*.stories.js

# Temporary files
.tmp
.temp
.cache
**/.DS_Store
npm-debug.log
yarn-debug.log
yarn-error.log
pnpm-debug.log

# Large media files that should be mounted or stored elsewhere
**/*.mp4
**/*.mov
**/*.iso
**/*.tar
**/*.gz
**/*.zip